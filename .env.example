# ─── Telegram (REQUIRED) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABCDEF...
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxx
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true

# ─── Football Data APIs (optional, see notes) ────────────────────────
# Primary (paid, 100 req/day free tier). Get a key at https://www.api-football.com/
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# Secondary — https://www.football-data.org/ (free tier: 10 req/min)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE=https://api.football-data.org/v4

# The-odds-api (optional) — https://the-odds-api.com/
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4

# ─── Scheduler ────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
PUBLISH_INTERVAL_MINUTES=90
MIN_CONFIDENCE=65
MAX_PREDICTIONS_PER_CYCLE=4
HOURS_AHEAD_MIN=1
HOURS_AHEAD_MAX=36
SCHEDULER_PAUSE=false

# ─── League Policy ────────────────────────────────────────────────────
# comma-separated. Empty = auto (top leagues only)
LEAGUES_INCLUDE=
LEAGUES_EXCLUDE=
LEAGUE_MIN_PRIORITY=50

# ─── Web Dashboard ────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_BASE_URL=https://your-domain.example

# ─── Affiliate (appended to every channel post) ───────────────────────
MELBET_LINK=https://melbet-49771.bar/en?tag=d_5217846m_2170c_&site=5217846&ad=2170&promo=KIKOS77
MELBET_PROMO_CODE=KIKOS77

# ─── Safety ───────────────────────────────────────────────────────────
DRY_RUN=false
NEVER_CLAIM_GUARANTEE=true

# ─── Logs ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
